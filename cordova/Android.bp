java_library {
    name: "cordova_framework",
    srcs: ["src/**/*.java"],
    exclude_srcs: ["src/org/apache/cordova/SystemBarPlugin.java"],
    static_libs: [
        "androidx_appcompat",
        "androidx_core",
        "androidx_webkit",
        "androidx_drawerlayout",
        "androidx_core_splashscreen",
        "androidx_customview",
        "androidx_fragment",
        "androidx_annotation",
        "androidx_activity",
        "androidx_kotlin-stdlib",
        "androidx_lifecycle-runtime",
        "androidx_lifecycle-common",
        "androidx_lifecycle-viewmodel",
        "androidx_savedstate",
    ],
    sdk_version: "current",
    platform_apis: true,
    visibility: ["//visibility:public"],
}
